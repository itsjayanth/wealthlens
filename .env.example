# ---- Database ----
DATABASE_URL=postgresql://wealthlens:wealthlens@localhost:5432/wealthlens

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Credential encryption (for Sharekhan API Key/Secure Key at rest) ----
# 32-byte key, base64 or hex encoded, used for AES-256-GCM encryption of linked_accounts secrets.
CREDENTIALS_ENCRYPTION_KEY=replace-with-32-byte-key-base64

# ---- Sharekhan broker integration ----
# Base URL of the broker adapter. Point this at the real Sharekhan API host once
# credentials are available; the adapter interface hides the exact API shape from
# the rest of the app so swapping "mock" for "sharekhan" is a config-only change.
SHAREKHAN_API_BASE_URL=https://api.sharekhan.com
SHAREKHAN_ADAPTER=mock

# ---- API server ----
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# ---- Web app ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
